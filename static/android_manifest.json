{
  "name": "JARVIS AI",
  "short_name": "JARVIS",
  "description": "Personal AI Assistant — powered by Gemini 2.5",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "portrait-primary",
  "start_url": "/android",
  "scope": "/",
  "theme_color": "#050F1E",
  "background_color": "#050F1E",
  "lang": "en-US",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "screenshots": [],
  "icons": [
    { "src": "/static/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/static/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Talk to JARVIS", "url": "/android#voice",    "description": "Open voice mode" },
    { "name": "Morning Brief",  "url": "/android#brief",    "description": "Daily briefing" },
    { "name": "Remote",         "url": "/remote",           "description": "PC remote control" }
  ],
  "share_target": {
    "action": "/android#share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "handle_links": "preferred",
  "protocol_handlers": [
    { "protocol": "jarvis", "url": "/android?cmd=%s" }
  ]
}
